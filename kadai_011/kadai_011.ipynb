      "source": [
        "# 繰り返し処理を使いこなそう\n",
        "\n",
        "課題のコードと実行結果を記録しています。"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 1,
      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "水\n",
            "金\n",
            "地\n",
            "火\n",
            "木\n",
            "土\n",
            "天\n",
            "海\n",
            "冥\n",
            "水\n",
            "金\n",
            "地\n",
            "火\n",
            "木\n",
            "土\n",
            "天\n",
            "海\n",
            "冥\n"
          ]
        }
      ],
      "source": [
        "planets = [\"水\", \"金\", \"地\", \"火\", \"木\", \"土\", \"天\", \"海\", \"冥\"]\n",
        "\n",
        "for planet in planets:\n",
        "    print(planet)\n",
        "\n",
        "index = 0\n",
        "while index < len(planets):\n",
        "    print(planets[index])\n",
        "    index += 1\n"
      ]
    }
